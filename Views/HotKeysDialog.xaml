<Window x:Class="MultiSSH.Views.HotKeysDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multi-SSH — Hot Keys"
        Height="460" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="#F0F0F0"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Hot keys" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10"
                   Text="Assign a command to a key. Click the key box, press the key (or key combo) you want, then type the command. Pressing that key in a terminal sends the command. Example: F1 → ls -lart | head"/>

        <!-- Column headers -->
        <Grid Grid.Row="1" Visibility="Collapsed"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="White"
                      BorderBrush="#BBB" BorderThickness="1">
            <StackPanel x:Name="RowsHost" Margin="8"/>
        </ScrollViewer>

        <Button Grid.Row="3" x:Name="AddBtn" Content="＋ Add hot key" HorizontalAlignment="Left"
                Margin="0,10,0,0" Padding="10,4" Click="Add_Click"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Width="90" Height="28" Margin="0,0,8,0" IsDefault="True" Click="Save_Click"/>
            <Button Content="Cancel" Width="90" Height="28" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
