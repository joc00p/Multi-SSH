<Window x:Class="MultiSSH.Views.PasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multi-SSH — Authentication"
        Height="190" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F0F0"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0" Text="Enter password" FontWeight="Bold"
                   TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBlock x:Name="TargetText" Grid.Row="1" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <PasswordBox x:Name="PassBox" Grid.Row="2" Height="26" VerticalContentAlignment="Center"
                     FontSize="13"/>

        <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="#B00020" TextWrapping="Wrap"
                   Margin="0,8,0,0" Visibility="Collapsed"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="90" Height="28" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="90" Height="28" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
