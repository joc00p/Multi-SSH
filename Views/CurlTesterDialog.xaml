<Window x:Class="MultiSSH.Views.CurlTesterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Curl — connectivity tester"
        Height="540" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Chrome.WindowBg}"
        MinWidth="520" MinHeight="360">
    <DockPanel Margin="12">
        <!-- Entry bar: method + URL/curl + send -->
        <DockPanel DockPanel.Dock="Top">
            <ComboBox x:Name="MethodCombo" DockPanel.Dock="Left" Width="92" Height="28" Margin="0,0,6,0"
                      VerticalContentAlignment="Center" SelectedIndex="0"
                      ToolTip="HTTP method (ignored when you type a full curl command)">
                <ComboBoxItem Content="GET"/>
                <ComboBoxItem Content="HEAD"/>
                <ComboBoxItem Content="POST"/>
                <ComboBoxItem Content="PUT"/>
                <ComboBoxItem Content="DELETE"/>
                <ComboBoxItem Content="OPTIONS"/>
                <ComboBoxItem Content="PATCH"/>
            </ComboBox>
            <Button x:Name="SendBtn" DockPanel.Dock="Right" Content="Send" Width="90" Height="28"
                    Margin="6,0,0,0" IsDefault="True" Click="Send_Click"/>
            <TextBox x:Name="UrlBox" Height="28" VerticalContentAlignment="Center" FontFamily="Consolas"
                     ToolTip="Enter a URL (example.com) or a full curl command (curl -I https://example.com)"/>
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Margin="2,6,0,0" FontSize="11"
                   Foreground="{DynamicResource Chrome.MutedText}"
                   Text="Type a URL or a curl command, then Send. Supported flags: -X, -I, -H, -d/--data, -L, -k, -A, -m, --connect-timeout."/>

        <!-- Response -->
        <Border Margin="0,10,0,0" BorderBrush="{DynamicResource Chrome.Border}" BorderThickness="1">
            <TextBox x:Name="OutBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                     Background="{DynamicResource Chrome.ContentBg}" Foreground="{DynamicResource Chrome.Text}"
                     BorderThickness="0" Padding="8"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     Text="Ready. Enter a URL or curl command above and press Send."/>
        </Border>
    </DockPanel>
</Window>
