<Window x:Class="MultiSSH.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multi-SSH" Height="720" Width="1080"
        Background="#1E1E24" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button" x:Key="ToolBtn">
            <Setter Property="Background" Value="#2D2D36"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3A3A44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#25252B" Padding="8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="NewBtn" Content="＋ New Session" Style="{StaticResource ToolBtn}" Click="New_Click"/>
                <Button x:Name="DupBtn" Content="⧉ Duplicate" Style="{StaticResource ToolBtn}" Click="Duplicate_Click"/>
                <Button x:Name="ReconnectBtn" Content="⟳ Reconnect" Style="{StaticResource ToolBtn}" Click="Reconnect_Click"/>
                <Button x:Name="SettingsBtn" Content="⚙ Settings" Style="{StaticResource ToolBtn}" Click="Settings_Click"/>
                <Separator Margin="6,0" Background="#3A3A44"/>
                <TextBlock Text="View:" Foreground="#AAA" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button x:Name="TabsBtn" Content="▭ Tabs" Style="{StaticResource ToolBtn}" Click="Tabs_Click"/>
                <Button x:Name="TilesBtn" Content="▦ Tiles" Style="{StaticResource ToolBtn}" Click="Tiles_Click"/>
            </StackPanel>
        </Border>

        <!-- Sidebar -->
        <Border DockPanel.Dock="Left" Width="210" Background="#25252B">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="SAVED SESSIONS" Foreground="#888"
                           FontSize="11" FontWeight="Bold" Margin="10,10,10,6"/>
                <TextBlock DockPanel.Dock="Bottom" Text="Double-click to open"
                           Foreground="#666" FontSize="10" Margin="10,6,10,10"/>
                <ListBox x:Name="SavedList" Background="Transparent" BorderThickness="0"
                         Foreground="White" MouseDoubleClick="SavedList_DoubleClick">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open" Click="MenuOpen_Click"/>
                            <MenuItem Header="Edit…" Click="MenuEdit_Click"/>
                            <MenuItem Header="Delete" Click="MenuDelete_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content host -->
        <Grid x:Name="ContentHost" Background="#12121A">
            <TextBlock x:Name="EmptyHint"
                       Text="No sessions open.&#x0a;Click &quot;＋ New Session&quot; or double-click a saved session."
                       Foreground="#666" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </DockPanel>
</Window>
